{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_name__",
  "version": "0.1.18",
  "description": "__MSG_description__",
  "homepage_url": "https://github.com/4ls4mi/misterdownloadmanager",
  "browser_specific_settings": {
    "gecko": {
      "id": "integration@auralis.download",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "cookies",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "proxy"
  ],
  "background": {
    "scripts": [
      "appearance-profile.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_name__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "appearance-profile.js",
        "companion-appearance.js",
        "video.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "appearance-profile.js",
        "companion-appearance.js",
        "thumbnail.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
