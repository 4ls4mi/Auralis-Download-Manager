{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mister Hybrid Glass",
  "version": "0.3.0",
  "identifier": "com.misterhybrid.glass",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mister Hybrid Glass",
        "width": 1180,
        "height": 720,
        "minWidth": 600,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "backgroundColor": "#00000000",
        "transparent": true,
        "shadow": false,
        "noRedirectionBitmap": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/mdm-legacy.exe": "mdm-legacy.exe",
      "resources/misterdownloadmanager-nmhost.exe": "misterdownloadmanager-nmhost.exe"
    }
  }
}
