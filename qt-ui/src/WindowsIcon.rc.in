#include <windows.h>

// Auralis icon SHA-256: @AURALIS_ICON_SHA256@
1 ICON "@auralis_icon@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Alsami\0"
            VALUE "FileDescription", "@auralis_file_description@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "OriginalFilename", "@auralis_original_filename@\0"
            VALUE "ProductName", "Auralis Download Manager\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
